rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/bliss_admins/$(request.auth.uid));
    }
    function isOwner() {
      return isAdmin() && get(/databases/$(database)/documents/bliss_admins/$(request.auth.uid)).data.role == 'owner';
    }
    // Team list. The owner is added by hand in the Firebase Console (role: "owner").
    // The owner can add or remove salespeople (role: "sales") from the Sales Desk.
    match /bliss_admins/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner() && request.resource.data.role == 'sales';
      allow delete: if isOwner() && uid != request.auth.uid;
      allow update: if false;
    }
    // One shared sales record for the whole team.
    match /bliss_sales/shared {
      allow read, write: if isAdmin();
    }
    // Older per-person record (read once to move it into the shared record).
    match /bliss_sales/{uid} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
